# ---------------------------------------------------------------------------
# BUnih — contoh konfigurasi. Salin menjadi .env lalu isi nilainya.
# JANGAN commit file .env yang sudah terisi.
# ---------------------------------------------------------------------------

NODE_ENV=production

# Server
BUNIH_PORT=8787
BUNIH_HOST=127.0.0.1
# URL publik aplikasi (dipakai untuk redirect OAuth Google)
BUNIH_BASE_URL=https://keuangan.contoh.id

# Penyimpanan
BUNIH_DATA_DIR=/var/lib/bunih
# Opsional; bawaan: <BUNIH_DATA_DIR>/bunih.sqlite
# BUNIH_DB_FILE=/var/lib/bunih/bunih.sqlite

# WAJIB di produksi.
# Kunci enkripsi token Gmail dan tanda tangan sesi web.
# Buat dengan: openssl rand -hex 32
BUNIH_SECRET_KEY=
# Kata sandi masuk web (satu pengguna).
BUNIH_WEB_PASSWORD=

BUNIH_TIMEZONE=Asia/Jakarta

# ---------------------------------------------------------------------------
# Gmail (izin baca saja: gmail.readonly)
# Buat OAuth Client ID tipe "Web application" di Google Cloud Console,
# aktifkan Gmail API, lalu daftarkan redirect URI di bawah.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://keuangan.contoh.id/api/gmail/callback

# ---------------------------------------------------------------------------
# Telegram
# Buat bot lewat @BotFather. Kirim /mulai ke bot untuk mengetahui Chat ID-mu.
# Bot HANYA menjawab chat id yang terdaftar di sini.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
# polling (paling sederhana, tanpa sertifikat) | webhook | off
TELEGRAM_MODE=polling
# Hanya untuk mode webhook: potongan rahasia pada URL webhook.
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Tugas terjadwal
# ---------------------------------------------------------------------------
BUNIH_ENABLE_SCHEDULER=true
BUNIH_GMAIL_SYNC_CRON_MINUTES=10
# Jam pengiriman ringkasan harian (zona Asia/Jakarta)
BUNIH_DAILY_DIGEST_HOUR=7
